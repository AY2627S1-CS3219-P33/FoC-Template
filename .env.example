# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Compose: service configuration ----------------------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_AUDIENCE=https://api.foc.local/user-service
SUPPLIER_AUTH0_ISSUER=https://your-tenant.auth0.com/
SUPPLIER_AUTH0_AUDIENCE=https://api.foc.local/supplier-service

# Required to bootstrap the first local super-admin on a fresh user database.
# Use the exact ID of an identity that already exists in Auth0.
BOOTSTRAP_AUTH0_SUBJECT=
BOOTSTRAP_USERNAME=
BOOTSTRAP_EMAIL=

# Optional: enables user directory and Auth0 role-management endpoints.
# Configure both IDs and the M2M credentials together; keep the secret private.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_USER_ROLE_ID=
AUTH0_ADMIN_ROLE_ID=

# ... Add more variables as needed
