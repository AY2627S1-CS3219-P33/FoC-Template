{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishServiceImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/user-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/supplier-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/credit-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/order-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/admin-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/chat-service",
        "arn:aws:ecr:ap-southeast-1:842761392141:repository/notification-service"
      ]
    },
    {
      "Sid": "RegisterRevisions",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "DescribeTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "ReadAndTagServiceRevisions",
      "Effect": "Allow",
      "Action": ["ecs:ListTagsForResource", "ecs:TagResource"],
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/user-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/supplier-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/credit-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/order-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/admin-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/chat-service-task:*",
        "arn:aws:ecs:ap-southeast-1:842761392141:task-definition/notification-service-task:*"
      ]
    },
    {
      "Sid": "UpdateExistingServices",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/user-service-task-service-tb6pn0x0",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/supplier-service-task-service-ot78zbdx",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/credit-service",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/order-service-task-service-177de1f2",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/admin-service-task-service-vmoebao1",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/chat-service",
        "arn:aws:ecs:ap-southeast-1:842761392141:service/comfortable-squirrel-pxwxt5/notification-service"
      ]
    },
    {
      "Sid": "PassExistingTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::842761392141:role/ecsTaskExecutionRole",
        "arn:aws:iam::842761392141:role/foc-supplier-task-role"
      ],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "ListDeploymentPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::foc-supplier-images",
      "Condition": {"StringLike": {"s3:prefix": ["frontend/*", "deployments/*"]}}
    },
    {
      "Sid": "FrontendAndDeploymentRecords",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::foc-supplier-images/frontend/*",
        "arn:aws:s3:::foc-supplier-images/deployments/*"
      ]
    },
    {
      "Sid": "InvalidateFrontend",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::842761392141:distribution/E39SHVSD0FXUB9"
    }
  ]
}
