# Copy this file to .env and replace each blank value for your environment.
# Do not put real credentials in this example file.
#
# Under the root `docker compose up`, compose.yaml overrides HTTP_HOST,
# HTTP_PORT, DATABASE_URL, AMQP_URL and ORDER_SERVICE_URL with the container
# addresses; the values here are for `go run` on the host.

APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3005
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=30s

# The runtime role (admin_service): data access only. Migrations run as a
# separate migrator role (see migrations/README.md).
# Docker RDS connections: sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
# Passwords for the admin-db container's two roles; compose builds the
# database URLs from them. Empty uses the local-development defaults.
ADMIN_MIGRATOR_PASSWORD=
ADMIN_RUNTIME_PASSWORD=

# Auth0 API for this service: RS256, Enable RBAC, Add Permissions in the
# Access Token. Administrators hold dashboard:read.
AUTH0_ISSUER=https://<your-auth0-domain>/
AUTH0_AUDIENCE=https://api.foc.local/admin-service
AUTH0_CLOCK_SKEW=30s
AUTH0_JWKS_CACHE_TTL=5m
AUTH0_JWKS_FETCH_TIMEOUT=3s
AUTH0_JWKS_REFRESH_INTERVAL=10s
AUTH0_JWKS_FETCH_ATTEMPTS=1
AUTH0_JWKS_BREAKER_THRESHOLD=3
AUTH0_JWKS_BREAKER_COOLDOWN=30s

# Required. Auth0 Machine to Machine application in the AUTH0_ISSUER tenant,
# authorised for the order-service API with orders:admin-read only.
ADMIN_M2M_CLIENT_ID=
ADMIN_M2M_CLIENT_SECRET=
ORDER_AUDIENCE=https://api.foc.local/order-service

# Required; no trailing slash.
ORDER_SERVICE_URL=
ORDER_SERVICE_TIMEOUT=5s

# Required; startup fails without it.
AMQP_URL=
TEST_AMQP_URL=
# 1 to 1000; default 16.
EVENTS_PREFETCH=

# RabbitMQ credentials for compose's AMQP_URL. They must match the root
# queue-service's RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS.
# RABBITMQ_DEFAULT_USER=
# RABBITMQ_DEFAULT_PASS=

# The time zone whose midnights bound a day in the metrics. Default
# Asia/Singapore.
DASHBOARD_TIMEZONE=

# Readiness section of the dashboard: each service's /readyz is read over the
# internal network. Empty skips a service (it is then listed as not checked).
# No trailing slash.
SUPPLIER_SERVICE_URL=
CREDIT_SERVICE_URL=
USER_SERVICE_URL=
READINESS_TIMEOUT=2s
