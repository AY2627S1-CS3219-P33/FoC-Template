# AI Assistance Disclosure:
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-11-10
# Scope: Boilerplate generation for build/container/tooling configuration.
# Author review: Reviewed, validated, and tested by the authors.

# Copy this file to .env and replace each blank value for your environment.
# Do not put real credentials in this example file.
#
# Under the root `docker compose up`, compose.yaml overrides HTTP_HOST,
# HTTP_PORT, DATABASE_URL and AMQP_URL with the container addresses; the
# values here are for `go run` on the host.

APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3006
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=30s

# Required. Docker RDS connections:
# sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_URL=
# Only read when APP_ENV=test (see compose.test.yaml, port 5435).
TEST_DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
# Password for the chat-db container; compose builds DATABASE_URL from it.
# Empty uses the local-development default.
CHAT_DB_PASSWORD=

# Required; rooms are created from errand events. Locally, the queue-service
# container of the root compose.yaml. The URL holds a password and is never
# logged.
AMQP_URL=amqp://foc:foc-local-dev@localhost:5672/
# Events RabbitMQ sends ahead of acknowledgements (1 to 1000).
AMQP_PREFETCH=10
# A throwaway RabbitMQ for integration tests (compose.test.yaml, port 5674).
# The tests delete and recreate chat-service's queues on it.
TEST_AMQP_URL=

# Auth0 API: RS256, Enable RBAC, Add Permissions in the Access Token,
# permissions chats:use and chats:export (see README, "Auth0 set-up").
# AUTH0_ISSUER is required (compose falls back to a placeholder tenant, which
# makes every token fail). It is the same tenant the other services use.
AUTH0_ISSUER=https://<your-auth0-domain>/
AUTH0_AUDIENCE=https://api.foc.local/chat-service
# Optional tuning of token checks; the defaults match order-service.
AUTH0_CLOCK_SKEW=30s
AUTH0_JWKS_CACHE_TTL=5m
AUTH0_JWKS_FETCH_TIMEOUT=3s
AUTH0_JWKS_REFRESH_INTERVAL=10s
AUTH0_JWKS_FETCH_ATTEMPTS=1
AUTH0_JWKS_BREAKER_THRESHOLD=3
AUTH0_JWKS_BREAKER_COOLDOWN=30s

# How long a room stays writable after its errand ends. Use 1m for manual
# testing.
CHAT_CLOSE_DELAY=24h
# 1 to 2000 (the database limit).
CHAT_MAX_MESSAGE_LENGTH=2000
# Token bucket per WebSocket connection: messages per second, and burst.
CHAT_SEND_RATE=5
CHAT_SEND_BURST=10

# Required. Comma-separated host patterns (no scheme) of the pages allowed to
# open a WebSocket. Production: app.bestfoc.app
WS_ALLOWED_ORIGINS=localhost:8081,localhost:5173
WS_AUTH_TIMEOUT=5s
# Must be shorter than the ALB idle timeout (60s).
WS_PING_INTERVAL=25s
WS_MAX_CONNECTIONS_PER_USER=5

# Optional; empty selects the in-process broadcaster (one copy only).
REDIS_URL=
