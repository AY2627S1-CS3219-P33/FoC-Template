# Admin credentials for infra/bootstrap.sh and infra/migrate.sh.
# Copy to .env.admin (gitignored). The service itself never reads this file.
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=require

# Application database to create or adopt (the RDS "initial database name" if you set one).
APP_DB=
# Generate each with: openssl rand -hex 24
MIGRATOR_PW=
APP_PW=
