# Copy to .env (gitignored). This file is read by the service only and holds
# the least-privileged app_rw credentials. Admin and migrator credentials live
# in .env.admin (see .env.admin.example) and never reach the service.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3004
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=30s

# postgres://app_rw:<APP_PW>@<instance>.<region>.rds.amazonaws.com:5432/<APP_DB>?sslmode=require
# Use sslmode=verify-full with sslrootcert=<path to the RDS CA bundle> for full verification.
DATABASE_URL=
# Only read when APP_ENV=test (see compose.test.yaml, port 5434).
TEST_DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
