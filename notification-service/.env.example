# AI Assistance Disclosure:
# Tool: Claude, date: 2026-11-11
# Scope: example runtime environment configuration for notification-service.
# Author review: I validated correctness, edited for style, and added boundary checks.

# Copy to .env (gitignored). This file is read by the service only and holds
# the least-privileged app_rw credentials. Migrator credentials are used only
# by the migrate job and never reach the service.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3007
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=30s

# postgres://app_rw:<APP_PW>@<instance>.<region>.rds.amazonaws.com:5432/<APP_DB>?sslmode=require
# Use sslmode=verify-full with sslrootcert=<path to the RDS CA bundle> for full verification.
# Docker image certificate path: /etc/ssl/certs/rds-global-bundle.pem
DATABASE_URL=
# Only read when APP_ENV=test.
TEST_DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# RabbitMQ (required). Locally: the queue-service container of the root
# compose.yaml, whose user and password are RABBITMQ_DEFAULT_USER and
# RABBITMQ_DEFAULT_PASS there. From inside a container, use the broker's host
# name instead of localhost. The URL holds a password and is never logged.
AMQP_URL=amqp://foc:foc-local-dev@localhost:5672/
# Optional: AMQP_PREFETCH (16).

# Auth0 tenant that issues the access tokens (HTTPS origin, trailing slash).
AUTH0_ISSUER=https://<your-auth0-domain>/
# API identifier configured in Auth0 for this service.
AUTH0_AUDIENCE=https://api.foc.local/notification-service
# AUTH0_CLOCK_SKEW, AUTH0_JWKS_CACHE_TTL, AUTH0_JWKS_FETCH_TIMEOUT,
# AUTH0_JWKS_REFRESH_INTERVAL, AUTH0_JWKS_FETCH_ATTEMPTS,
# AUTH0_JWKS_BREAKER_THRESHOLD and AUTH0_JWKS_BREAKER_COOLDOWN are optional.
