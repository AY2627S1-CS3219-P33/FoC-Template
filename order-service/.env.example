# Copy this file to .env and replace each blank value for your environment.
# Do not put real credentials in this example file.
#
# Under the root `docker compose up`, compose.yaml overrides HTTP_HOST,
# HTTP_PORT, DATABASE_URL, REDIS_URL, AMQP_URL and SUPPLIER_SERVICE_URL with
# the container addresses; the values here are for `go run` on the host.

APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3003
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=30s

DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
# Password for the order-db container; compose builds DATABASE_URL from it.
# Empty uses the local-development default.
ORDER_DB_PASSWORD=

# Auth0 API: RS256, Enable RBAC, Add Permissions in the Access Token.
AUTH0_ISSUER=https://<your-auth0-domain>/
AUTH0_AUDIENCE=https://api.foc.local/order-service
AUTH0_CLOCK_SKEW=30s
AUTH0_JWKS_CACHE_TTL=5m
AUTH0_JWKS_FETCH_TIMEOUT=3s
AUTH0_JWKS_REFRESH_INTERVAL=10s
AUTH0_JWKS_FETCH_ATTEMPTS=1
AUTH0_JWKS_BREAKER_THRESHOLD=3
AUTH0_JWKS_BREAKER_COOLDOWN=30s

# Required. Auth0 Machine to Machine application in the AUTH0_ISSUER tenant,
# authorised for the supplier API with suppliers:read only.
ORDER_M2M_CLIENT_ID=
ORDER_M2M_CLIENT_SECRET=
SUPPLIER_AUDIENCE=https://api.foc.local/supplier-service

# Required; no trailing slash.
SUPPLIER_SERVICE_URL=
SUPPLIER_SERVICE_TIMEOUT=2s

# Optional; empty selects the no-op cache.
REDIS_URL=
TEST_REDIS_URL=

# Required; startup fails without it.
AMQP_URL=
TEST_AMQP_URL=
# true binds order-events.tap to errand.# so events stay inspectable until a
# notification consumer exists. Without any binding, events cannot be routed
# and are retried until FAILED. Compose defaults it to true.
AMQP_DECLARE_TAP=
# 1 to 1000; default 16.
CREDIT_RESULTS_PREFETCH=

# RabbitMQ credentials for compose's AMQP_URL. They must match the root
# queue-service's RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS.
# RABBITMQ_DEFAULT_USER=
# RABBITMQ_DEFAULT_PASS=
