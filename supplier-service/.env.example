# Copy this file to .env and replace each blank value for your environment.
# Do not put real credentials in this example file.

APP_ENV=
HTTP_HOST=
HTTP_PORT=
LOG_LEVEL=
SHUTDOWN_TIMEOUT=
STARTUP_TIMEOUT=30s

DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
SUPPLIER_SEED_DATASET_NAMESPACE=template-v1
# Required; use a mounted absolute path in containers.
SUPPLIER_SEED_CSV_PATH=../data/csv/supplier-seed-data.csv

# Auth0 API: RS256, Enable RBAC, Add Permissions in the Access Token.
AUTH0_ISSUER=https://<your-auth0-domain>/
AUTH0_AUDIENCE=https://api.foc.local/supplier-service
AUTH0_CLOCK_SKEW=30s
AUTH0_JWKS_CACHE_TTL=5m
AUTH0_JWKS_FETCH_TIMEOUT=3s
AUTH0_JWKS_REFRESH_INTERVAL=10s
AUTH0_JWKS_FETCH_ATTEMPTS=1
AUTH0_JWKS_BREAKER_THRESHOLD=3
AUTH0_JWKS_BREAKER_COOLDOWN=30s

# Order-service deletion fence (supplier deletion). Leave ORDER_SERVICE_URL
# empty to disable deletion (it then returns 503 DELETION_FENCE_UNAVAILABLE).
# Use https when APP_ENV=production; http is accepted only outside production.
# No trailing slash.
ORDER_SERVICE_URL=http://localhost:3003
# Auth0 Machine to Machine application for supplier-service, authorised for
# the order-service API with orders:internal only. Tokens come from
# ${AUTH0_ISSUER}oauth/token. Required when ORDER_SERVICE_URL is set.
SUPPLIER_M2M_CLIENT_ID=
SUPPLIER_M2M_CLIENT_SECRET=
ORDER_AUDIENCE=https://api.foc.local/order-service
# Per-attempt timeout and attempts for each fence call (timeouts, 429 and 5xx
# are retried; every fence call is idempotent).
ORDER_SERVICE_TIMEOUT=2s
ORDER_SERVICE_MAX_ATTEMPTS=2
# How often the reconciler resumes unfinished deletions (for example a
# 202 commit_pending). It runs only when ORDER_SERVICE_URL is set.
DELETION_RECONCILE_INTERVAL=15s
