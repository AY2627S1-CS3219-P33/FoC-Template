# Copy this file to .env and replace each blank value for your environment.
# Do not put real credentials in this example file.

APP_ENV=
HTTP_HOST=
HTTP_PORT=
LOG_LEVEL=
SHUTDOWN_TIMEOUT=
STARTUP_TIMEOUT=30s

DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
SUPPLIER_SEED_DATASET_NAMESPACE=template-v1
# Required; use a mounted absolute path in containers.
SUPPLIER_SEED_CSV_PATH=../data/csv/supplier-seed-data.csv

# Auth0 API: RS256, Enable RBAC, Add Permissions in the Access Token.
AUTH0_ISSUER=https://<your-auth0-domain>/
AUTH0_AUDIENCE=https://api.foc.local/supplier-service
AUTH0_CLOCK_SKEW=30s
AUTH0_JWKS_CACHE_TTL=5m
AUTH0_JWKS_FETCH_TIMEOUT=3s
AUTH0_JWKS_REFRESH_INTERVAL=10s
AUTH0_JWKS_FETCH_ATTEMPTS=1
AUTH0_JWKS_BREAKER_THRESHOLD=3
AUTH0_JWKS_BREAKER_COOLDOWN=30s
