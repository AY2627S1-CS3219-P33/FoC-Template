# Public browser configuration only. Domain/client ID/audience come from /api/auth/config.
VITE_AUTH0_CONNECTION=Username-Password-Authentication
VITE_SUPPLIER_AUDIENCE=https://api.foc.local/supplier-service
VITE_ORDER_AUDIENCE=https://api.foc.local/order-service
# The admin dashboard's metrics and readiness. Administrators need the
# dashboard:read permission on this API.
VITE_ADMIN_AUDIENCE=https://api.foc.local/admin-service
# credit-service is not implemented yet; the credit screens follow the proposed
# contract in credit-service/openapi.yaml.
VITE_CREDIT_AUDIENCE=https://api.foc.local/credit-service
VITE_NOTIFICATION_AUDIENCE=https://api.foc.local/notification-service
VITE_CHAT_AUDIENCE=https://api.foc.local/chat-service
# Never add client secrets or Management API tokens to VITE_ variables.
