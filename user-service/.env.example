# Copy to .env for local development. Never commit real tenant values.
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://user:password@localhost:5432/user_service
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://api.foc.local/user-service

# Server-side Auth0 Management API credentials and role IDs for admin role changes.
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret
AUTH0_USER_ROLE_ID=your-user-role-id
AUTH0_ADMIN_ROLE_ID=your-administrator-role-id

# Existing Auth0 identity for first initialization only. No password is accepted.
BOOTSTRAP_AUTH0_SUBJECT=
BOOTSTRAP_USERNAME=
BOOTSTRAP_EMAIL=

# Optional: create a credit wallet when an account is provisioned. The M2M
# client must hold credits:wallets:create on the credit service API.
CREDIT_SERVICE_URL=
CREDIT_AUDIENCE=https://api.foc.local/credit-service
CREDIT_M2M_CLIENT_ID=
CREDIT_M2M_CLIENT_SECRET=
