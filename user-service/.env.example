# Copy to .env for local development. Never commit real tenant values.
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://user:password@localhost:5432/user_service
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://api.foc.local/user-service

# Existing Auth0 identity for first initialization only. No password is accepted.
BOOTSTRAP_AUTH0_SUBJECT=
BOOTSTRAP_USERNAME=
BOOTSTRAP_EMAIL=
